<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- multi target: net10 for Windows 10+ (toast notifications), net48 for Windows 7/8 (classic balloons) -->
    <TargetFrameworks>net10.0-windows10.0.17763;net48</TargetFrameworks>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <!-- keep the tracked bin\ folder as the net10 build; the net48 build goes to bin\net48\ -->
    <AppendTargetFrameworkToOutputPath Condition=" '$(TargetFramework)' == 'net48' ">true</AppendTargetFrameworkToOutputPath>
    <!-- the binary resources (icons) in the resx need preserialized resources on net48 -->
    <GenerateResourceUsePreserializedResources Condition=" '$(TargetFramework)' == 'net48' ">true</GenerateResourceUsePreserializedResources>
    <!-- portable build (-p:Portable=true): store user data in a data folder next to the executable -->
    <DefineConstants Condition=" '$(Portable)' == 'true' ">$(DefineConstants);PORTABLE</DefineConstants>
    <OutputType>WinExe</OutputType>
    <StartupObject>BalloonRss.FormMain</StartupObject>
    <ApplicationIcon>Resources\yellow32.ico</ApplicationIcon>
    <IsWebBootstrapper>false</IsWebBootstrapper>
    <ManifestCertificateThumbprint>282041D023C50110CF189BFA460BC6C941A5A64A</ManifestCertificateThumbprint>
    <ManifestKeyFile>BalloonRss_TemporaryKey.pfx</ManifestKeyFile>
    <GenerateManifests>false</GenerateManifests>
    <SignManifests>false</SignManifests>
    <PublishUrl>..\publish\</PublishUrl>
    <Install>true</Install>
    <InstallFrom>Disk</InstallFrom>
    <UpdateEnabled>false</UpdateEnabled>
    <UpdateMode>Foreground</UpdateMode>
    <UpdateInterval>7</UpdateInterval>
    <UpdateIntervalUnits>Days</UpdateIntervalUnits>
    <UpdatePeriodically>false</UpdatePeriodically>
    <UpdateRequired>false</UpdateRequired>
    <MapFileExtensions>true</MapFileExtensions>
    <SupportUrl>https://embyt.github.io/balloonrss</SupportUrl>
    <TargetCulture>en</TargetCulture>
    <ProductName>BalloonRSS</ProductName>
    <ApplicationRevision>1</ApplicationRevision>
    <ApplicationVersion>0.1.0.%2a</ApplicationVersion>
    <UseApplicationTrust>false</UseApplicationTrust>
    <BootstrapperEnabled>true</BootstrapperEnabled>
    <TargetZone>LocalIntranet</TargetZone>
    <ApplicationManifest>Properties\app.manifest</ApplicationManifest>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <UseWindowsForms>true</UseWindowsForms>
    <ImportWindowsDesktopTargets>true</ImportWindowsDesktopTargets>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
    <OutputPath>..\bin\Debug\</OutputPath>
    <CheckForOverflowUnderflow>true</CheckForOverflowUnderflow>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
    <OutputPath>..\bin\</OutputPath>
    <CheckForOverflowUnderflow>true</CheckForOverflowUnderflow>
  </PropertyGroup>
  <ItemGroup>
    <Compile Update="utils\NumericTextBox.cs">
      <SubType>Component</SubType>
    </Compile>
  </ItemGroup>
  <ItemGroup Condition=" '$(TargetFramework)' == 'net48' ">
    <!-- framework assemblies that are not referenced by default in SDK-style projects -->
    <Reference Include="System.Configuration" />
  </ItemGroup>
  <ItemGroup>
    <BootstrapperPackage Include="Microsoft.Net.Framework.2.0">
      <Visible>False</Visible>
      <ProductName>.NET Framework 2.0 %28x86%29</ProductName>
      <Install>true</Install>
    </BootstrapperPackage>
    <BootstrapperPackage Include="Microsoft.Net.Framework.3.0">
      <Visible>False</Visible>
      <ProductName>.NET Framework 3.0 %28x86%29</ProductName>
      <Install>false</Install>
    </BootstrapperPackage>
    <BootstrapperPackage Include="Microsoft.Net.Framework.3.5">
      <Visible>False</Visible>
      <ProductName>.NET Framework 3.5</ProductName>
      <Install>false</Install>
    </BootstrapperPackage>
  </ItemGroup>
  <ItemGroup>
    <None Include="..\help\balloonrss.chm">
      <Link>balloonrss.chm</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Remove="Resources\strings.de.resx" />
    <EmbeddedResource Remove="Resources\strings.pt.resx" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.DotNet.UpgradeAssistant.Extensions.Default.Analyzers" Version="0.4.355802">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!-- toasts are only used by the net10 build (Windows 10+) -->
    <PackageReference Include="Microsoft.Toolkit.Uwp.Notifications" Version="7.1.3" Condition=" '$(TargetFramework)' != 'net48' " />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
    <!-- needed to deserialize the binary resx resources on net48 -->
    <PackageReference Include="System.Resources.Extensions" Version="8.0.0" Condition=" '$(TargetFramework)' == 'net48' " />
    <!-- the settings/configuration APIs already exist in the .NET Framework -->
    <PackageReference Include="Microsoft.Windows.Compatibility" Version="10.0.0" Condition=" '$(TargetFramework)' != 'net48' " />
  </ItemGroup>
</Project>